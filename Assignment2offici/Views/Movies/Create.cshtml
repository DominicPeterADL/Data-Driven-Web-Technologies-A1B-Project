@using System;
@using System.Globalization;
@using WebMatrix.Data;

@{
    ViewBag.Title = "Create Movie";

    string title = "";
    string releaseYearText = "";
    string runtimeText = "";
    string classification = "";
    string rentalPriceText = "";
    string description = "";
    string posterFilename = "";

    string errorMessage = "";

    if (Request.HttpMethod == "POST")
    {
        title = Request.Form["title"] ?? "";
        releaseYearText = Request.Form["release_year"] ?? "";
        runtimeText = Request.Form["runtime_minutes"] ?? "";
        classification = Request.Form["classification"] ?? "";
        rentalPriceText = Request.Form["rental_price"] ?? "";
        description = Request.Form["description"] ?? "";
        posterFilename = Request.Form["poster_filename"] ?? "";

        int releaseYear = 0;
        int runtimeMinutes = 0;
        decimal rentalPrice = 0;

        bool valid = true;

        if (String.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Please enter a movie title.";
            valid = false;
        }
        else if (!int.TryParse(releaseYearText, out releaseYear)
                 || releaseYear < 1888
                 || releaseYear > DateTime.Now.Year + 5)
        {
            errorMessage = "Please enter a valid release year.";
            valid = false;
        }
        else if (!int.TryParse(runtimeText, out runtimeMinutes)
                 || runtimeMinutes <= 0)
        {
            errorMessage = "Please enter a valid runtime.";
            valid = false;
        }
        else if (!decimal.TryParse(rentalPriceText,
                 NumberStyles.Number,
                 CultureInfo.InvariantCulture,
                 out rentalPrice)
                 || rentalPrice < 0)
        {
            errorMessage = "Please enter a valid rental price.";
            valid = false;
        }
        else if (classification != "G"
                 && classification != "PG"
                 && classification != "M"
                 && classification != "MA15+"
        {
            errorMessage = "Please select a valid classification.";
            valid = false;
        }
        else if (String.IsNullOrWhiteSpace(description))
        {
            errorMessage = "Please enter a movie description.";
            valid = false;
        }

        if (valid)
        {
            try
            {
                var db = Database.Open("dvdRental");

                var newMovieId = db.QueryValue(
                    @"INSERT INTO movies
                      (title, release_year, runtime_minutes,
                       classification, rental_price, description,
                       poster_filename)
                      VALUES (@0, @1, @2, @3, @4, @5, @6)
                      RETURNING movie_id",
                    title,
                    releaseYear,
                    runtimeMinutes,
                    classification,
                    rentalPrice,
                    description,
                    posterFilename
                );

                if (newMovieId != null)
                {
                    Response.Redirect(
                        Url.Action("Details", "Movies")
                        + "?id=" + newMovieId
                    );
                }
                else
                {
                    errorMessage = "Movie was not saved. Please try again.";
                }
            }
            catch (Exception)
            {
                errorMessage = "Movie could not be saved. Please check your details and try again.";
            }
        }
    }
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Add New Movie</h2>
        <p class="text-muted">
            Enter the movie information below to add it to the catalogue.
        </p>
    </div>

    @if (!String.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form method="post"
                  action="@Url.Action("Create", "Movies")">

                <h5 class="mb-3">Movie Information</h5>

                <div class="mb-3">
                    <label for="title" class="form-label">
                        Movie Title *
                    </label>
                    <input type="text"
                           class="form-control"
                           id="title"
                           name="title"
                           value="@title"
                           maxlength="255"
                           required />
                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label for="release_year" class="form-label">
                            Release Year *
                        </label>
                        <input type="number"
                               class="form-control"
                               id="release_year"
                               name="release_year"
                               value="@releaseYearText"
                               min="1888"
                               max="@(DateTime.Now.Year + 5)"
                               required />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label for="runtime_minutes" class="form-label">
                            Runtime (minutes) *
                        </label>
                        <input type="number"
                               class="form-control"
                               id="runtime_minutes"
                               name="runtime_minutes"
                               value="@runtimeText"
                               min="1"
                               required />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label for="classification" class="form-label">
                            Classification *
                        </label>
                        <select class="form-select"
                                id="classification"
                                name="classification"
                                required>
                            <option value="">Select classification</option>
                            <option value="G" @(classification == "G" ? "selected" : "")>G</option>
                            <option value="PG" @(classification == "PG" ? "selected" : "")>PG</option>
                            <option value="M" @(classification == "M" ? "selected" : "")>M</option>
                            <option value="MA15+" @(classification == "MA15+" ? "selected" : "")>MA15+</option>
                        </select>
                    </div>

                </div>

                <div class="mb-3">
                    <label for="rental_price" class="form-label">
                        Rental Price ($) *
                    </label>
                    <input type="number"
                           class="form-control"
                           id="rental_price"
                           name="rental_price"
                           value="@rentalPriceText"
                           min="0"
                           step="0.01"
                           required />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">
                        Movie Description *
                    </label>
                    <textarea class="form-control"
                              id="description"
                              name="description"
                              rows="4"
                              required>@description</textarea>
                </div>

                <hr class="my-4" />

                <h5 class="mb-3">Movie Poster</h5>

                <div class="mb-4">
                    <label for="poster_filename" class="form-label">
                        Poster Filename
                    </label>
                    <input type="text"
                           class="form-control"
                           id="poster_filename"
                           name="poster_filename"
                           value="@posterFilename"
                           placeholder="Enter poster filename" />
                    <div class="form-text">
                        Enter the filename of the movie poster.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit" class="btn btn-primary px-4">
                        Add Movie
                    </button>

                    <a href="@Url.Action("Index", "Movies")"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

                <p class="text-muted small mt-3 mb-0">
                    * Required fields
                </p>

            </form>

        </div>
    </div>

</div>
